{
  "name": "codex-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run --bun next dev --webpack",
    "build": "bun run --bun next build --webpack",
    "start": "bun run --bun next start",
    "db:migrate": "bun run scripts/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bun run scripts/run-e2e.ts",
    "test:e2e:ui": "bun run scripts/run-e2e.ts --ui",
    "test:e2e:prepare": "bun run scripts/prepare-e2e.ts",
    "test:all": "bun run test && bun run test:e2e",
    "lint": "oxlint",
    "format": "oxfmt",
    "commit": "cz"
  },
  "dependencies": {
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "better-auth": "1.6.23",
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.0.0",
    "eslint-config-next": "16.1.6",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.33.0",
    "oxlint": "^1.48.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
